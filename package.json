{
  "name": "capataz",
  "productName": "Capataz",
  "version": "1.0.0",
  "description": "Asistente personal de obra: trabajos, avisos y conversación con Claude",
  "main": "electron/main.js",
  "private": true,
  "scripts": {
    "build": "node scripts/build.mjs",
    "web": "npm run build && npx --yes serve www",
    "android:add": "npm run build && npx cap add android && node scripts/android-permisos.mjs",
    "android:sync": "npm run build && npx cap sync android && node scripts/android-permisos.mjs",
    "android:apk": "npm run android:sync && cd android && ./gradlew assembleDebug",
    "electron": "npm run build && electron .",
    "electron:exe": "npm run build && electron-builder --win nsis",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "@aparajita/capacitor-secure-storage": "7.1.6",
    "@capacitor-community/speech-recognition": "7.0.1",
    "@capacitor-community/sqlite": "7.0.3",
    "@capacitor-community/text-to-speech": "6.1.0",
    "@capacitor/android": "7.6.9",
    "@capacitor/core": "7.6.9",
    "@capacitor/local-notifications": "7.0.7",
    "better-sqlite3": "11.10.0"
  },
  "devDependencies": {
    "@capacitor/cli": "7.6.9",
    "electron": "31.7.7",
    "electron-builder": "25.1.8",
    "esbuild": "0.25.10"
  },
  "build": {
    "appId": "bo.capataz.app",
    "productName": "Capataz",
    "directories": { "output": "dist" },
    "files": [
      "electron/**",
      "www/**",
      "recursos/**",
      "!node_modules/@capacitor/**",
      "!node_modules/@capacitor-community/**",
      "!node_modules/@aparajita/**"
    ],
    "win": { "target": "nsis", "icon": "recursos/icono.png" },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true, "createDesktopShortcut": true }
  }
}
